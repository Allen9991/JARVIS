# Supabase project URL used by the Next.js app and server routes.
SUPABASE_URL=https://example.supabase.co

# Supabase anonymous key safe for browser-side Supabase Auth.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key for server-side jobs only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL connection string for Drizzle migrations and server-side database access.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Anthropic API key for Claude model calls in the AI service.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Nylas API key for Gmail, Outlook, and Exchange email integration.
NYLAS_API_KEY=your-nylas-api-key

# Nylas OAuth client ID for email account connection flows.
NYLAS_CLIENT_ID=your-nylas-client-id

# Resend API key for transactional email and teammate invites.
RESEND_API_KEY=your-resend-api-key

# Railway API token used by deployment automation for the Python AI service.
RAILWAY_TOKEN=your-railway-token

# Vercel API token used by deployment automation for the Next.js app.
VERCEL_TOKEN=your-vercel-token

# Public URL for the Railway-hosted Python AI service.
AI_SERVICE_URL=https://atlas-ai-service.example.com

# Shared HMAC secret used to sign requests from Next.js to the AI service.
AI_SERVICE_SHARED_SECRET=replace-with-32-byte-hex-secret

# Sentry DSN for Next.js error and performance monitoring.
SENTRY_DSN=https://example@sentry.io/project-id

# Axiom dataset name for structured application logs.
AXIOM_DATASET=atlas-local

# Axiom API token for shipping structured logs.
AXIOM_TOKEN=your-axiom-token
